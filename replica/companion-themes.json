    "\\brestriction",
    "\\bpolicy\\b",
    "\\binterrupted\\b",
    "\\bfilter"
   ]
  },
  {
   "id": "paywall2",
   "label": "Pay to chat, no trial, price rises",
   "kind": "complaint",
   "patterns": [
    "\\bpay to\\b",
    "\\bpay just\\b",
    "\\bno free trial\\b",
    "\\btake your money\\b",
    "\\braised the price\\b",
    "\\blifetime\\b",
    "\\bannual subscription\\b",
    "\\$\\d+"
   ]
  },
  {
