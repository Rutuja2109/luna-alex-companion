{
 "_about": "Themes reviews.py sorts feedback into. Patterns are Python regular expressions, matched case-insensitively against the review text. kind is complaint (something users hate) or request (something users want that is missing). Edit freely: add the app category's own words (for a booking app: double booking, time zone, no-show).",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
 ],
 "themes": [
  {
   "id": "memory",
   "label": "Forgets you (memory loss)",
   "kind": "complaint",
   "patterns": [
    "\\bmemor(y|ies)\\b",
    "\\bforg(ot|et|ets|etting)\\b",
    "\\bremember",
    "\\bcontinuity\\b",
    "\\bwiped\\b"
   ]
  },
  {
   "id": "identity",
   "label": "Companion changed or was replaced after updates",
   "kind": "complaint",
   "patterns": [
    "\\brecogni[sz]e\\b",
    "\\bnot her anymore\\b",
    "\\bcame back different\\b",
    "\\bwhole new companion\\b",
    "\\bdifferent personality\\b",
    "\\bkeep changing\\b",
    "\\bgot worse\\b",
    "\\bmakes it worse\\b",
    "\\bcold ai\\b",
    "\\bnew version\\b",
    "\\b2\\.0\\b",
    "\\bupdate"
   ]
  },
  {
   "id": "repetitive",
   "label": "Repetitive, canned replies",
   "kind": "complaint",
   "patterns": [
    "\\brepetitive\\b",
    "\\bsame repeated\\b",
    "\\bauto replies\\b",
    "\\bnowhere near\\b",
    "\\bcanned\\b"
   ]
  },
  {
   "id": "proactive",
   "label": "Never reaches out first",
   "kind": "request",
   "patterns": [
    "\\binitiate\\b",
    "\\bchecks? in\\b",
    "\\breach out\\b"
   ]
  },
  {
   "id": "monitoring",
