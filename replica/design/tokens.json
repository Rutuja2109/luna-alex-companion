  "size": {"name-pill-h": 42, "glass-button": 48, "composer-h": 52, "plus-button": 52, "call-button": 58, "fab": 62, "bubble-pad-y": 15, "bubble-pad-x": 22},
  "shadow": {"bubble": "0 6px 24px rgba(0,0,0,.18)", "pop": "0 12px 32px rgba(0,0,0,.35)"},
